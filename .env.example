# Web
NEXT_PUBLIC_APP_NAME="Clima Alerta"

NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Backend futuro - nao preencher secrets reais neste arquivo
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
PAYLOAD_LIMIT=1mb

# PostgreSQL/PostGIS local
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=clima_alerta
DATABASE_USER=clima_alerta
DATABASE_PASSWORD=clima_alerta_dev_password
DATABASE_SSL=false
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=3000

# Redis local
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_KEY_PREFIX=clima-alerta
REDIS_CONNECT_TIMEOUT_MS=3000

# Weather provider
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_PROVIDER_TIMEOUT_MS=5000

# Notifications / Web Push
# Gere com: npx web-push generate-vapid-keys
NOTIFICATIONS_ENABLED=true
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@clima-alerta.local
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_HASH_SALT=
NOTIFICATION_QUEUE_PREFIX=clima-alerta:queue
NOTIFICATION_TEST_COOLDOWN_SECONDS=300
NOTIFICATION_DELIVERY_RETENTION_DAYS=30
